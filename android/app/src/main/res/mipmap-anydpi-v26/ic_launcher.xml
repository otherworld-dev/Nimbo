<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon. minSdk is 26, so every device that can install this
    app understands <adaptive-icon> and no density-specific raster fallback is
    needed (which is just as well — the artwork is vector, generated from the
    desktop client's icon source so the two cannot drift).

    <monochrome> is only read on API 33+ (themed icons); older platforms ignore
    the unknown tag.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
